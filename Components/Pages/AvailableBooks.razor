@page "/available-books"
@using CSE325_Group_Project.Models
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Available Books</PageTitle>

<div class="container mt-4 mb-5 pb-5">
    <div class="text-center mb-5">
        <h2 class="display-6 fw-bold" style="background: -webkit-linear-gradient(45deg, #198754, #20c997); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Available Books</h2>
        <p class="text-muted">Explore and read books shared by the community.</p>
    </div>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading available books...</p>
        </div>
    }
    else if (!books.Any())
    {
        <div class="alert alert-warning text-center shadow-sm py-5" role="alert">
            <h3 class="alert-heading fw-bold mb-3">Book Not Found</h3>
            <p class="text-muted mb-4">We couldn't find any available books in the library at this time.</p>
            <a href="/share-book" class="btn btn-primary px-4 py-2 rounded-pill">Share a Book</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var book in books)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 hover-card">
                        <div class="position-relative book-image-container">
                            <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height: 250px; object-fit: contain; object-position: center; background-color:black">
                            
                            <!-- Heart and Rating Overlay -->
                            <div class="position-absolute bottom-0 w-100 p-2 d-flex justify-content-between align-items-center" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                                <!-- Heart Icon (Like) -->
                                <button class="btn btn-link p-0 text-decoration-none shadow-none text-danger" @onclick="() => ToggleLike(book)">
                                    @if (book.IsLiked)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-heart text-white" viewBox="0 0 16 16">
                                            <path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01L8 2.748zM8 15C-7.333 4.868 3.279-3.04 7.824 1.143c.06.055.119.112.176.171a3.12 3.12 0 0 1 .176-.17C12.72-3.042 23.333 4.867 8 15z"/>
                                        </svg>
                                    }
                                </button>
                                
                                <!-- Rating Stars -->
                                <div class="text-warning d-flex align-items-center cursor-pointer">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var currentStar = i;
                                        <span @onclick="() => SetRating(book, currentStar)" style="cursor: pointer; font-size: 1rem;">
                                            @if (i <= book.Rating)
                                            {
                                                <!-- Filled Star -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill mb-1" viewBox="0 0 16 16">
                                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <!-- Empty Star -->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star mb-1" viewBox="0 0 16 16">
                                                    <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                                                </svg>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-truncate mb-1" title="@book.Title">@book.Title</h6>
                            <small class="card-subtitle text-muted mb-2 text-truncate">by @book.Author</small>
                            <div class="small text-muted mb-3" style="font-size: 0.75rem;">Released: @book.DateReleased.ToString("MMM dd, yyyy")</div>
                            <a href="@book.Url" target="_blank" class="btn btn-sm btn-primary mt-auto w-100 fw-semibold rounded-pill">
                                Read Book
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .book-image-container {
        overflow: hidden;
        border-top-left-radius: calc(0.375rem - 1px);
        border-top-right-radius: calc(0.375rem - 1px);
    }
</style>

@code {
    private List<Book> books = new List<Book>();
    private bool isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await LoadBooks();
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadBooks()
    {
        try
        {
            var booksJson = await JSRuntime.InvokeAsync<string>("window.localStorageInterop.getItem", "shared_books");
            if (!string.IsNullOrEmpty(booksJson))
            {
                var allBooks = System.Text.Json.JsonSerializer.Deserialize<List<Book>>(booksJson);
                if (allBooks != null)
                {
                    books = allBooks.Where(b => b.IsApproved).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading books: {ex.Message}");
        }
    }

    private async Task ToggleLike(Book book)
    {
        book.IsLiked = !book.IsLiked;
        await SaveBooksToStorage();
    }

    private async Task SetRating(Book book, int rating)
    {
        book.Rating = rating;
        await SaveBooksToStorage();
    }

    private async Task SaveBooksToStorage()
    {
        try
        {
            // We need to fetch all books first so we don't overwrite unapproved ones
            var booksJson = await JSRuntime.InvokeAsync<string>("window.localStorageInterop.getItem", "shared_books");
            if (!string.IsNullOrEmpty(booksJson))
            {
                var allBooks = System.Text.Json.JsonSerializer.Deserialize<List<Book>>(booksJson) ?? new List<Book>();
                
                // Update the modified books in the main list
                foreach (var b in books)
                {
                    var existing = allBooks.FirstOrDefault(x => x.Id == b.Id);
                    if (existing != null)
                    {
                        existing.IsLiked = b.IsLiked;
                        existing.Rating = b.Rating;
                    }
                }
                
                var updatedJson = System.Text.Json.JsonSerializer.Serialize(allBooks);
                await JSRuntime.InvokeVoidAsync("window.localStorageInterop.setItem", "shared_books", updatedJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving book updates: {ex.Message}");
        }
    }
}
